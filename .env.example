# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
PORT=3000

# SharePoint / Microsoft Graph API (optional - leave blank to disable)
SHAREPOINT_TENANT_ID=your_azure_tenant_id
SHAREPOINT_CLIENT_ID=your_azure_app_client_id
SHAREPOINT_CLIENT_SECRET=your_azure_app_client_secret
SHAREPOINT_SITE_URL=https://yourorg.sharepoint.com/sites/yoursite
SHAREPOINT_DRIVE_ID=your_document_library_drive_id
